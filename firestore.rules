rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function accountLinkPath() {
      return /databases/$(database)/documents/accountLinks/$(request.auth.token.email.lower());
    }

    function hasAccountLink() {
      return verifiedAccount() && exists(accountLinkPath());
    }

    function accountLink() {
      return get(accountLinkPath()).data;
    }

    function linkedTo(householdId) {
      return hasAccountLink() && accountLink().householdId == householdId;
    }

    // An existing migration contract fences every v116 writer, including import chunks.
    function legacyWritable(householdId) {
      return !exists(/databases/$(database)/documents/households/$(householdId)/financialStorage/current);
    }

    function legacyWriter(householdId) {
      return linkedTo(householdId) && legacyWritable(householdId);
    }

    // Een geverifieerd account kan uitsluitend zijn vooraf aangemaakte koppeling lezen.
    // Rollen en huishoudens worden nooit door de browser aangemaakt of gewijzigd.
    match /accountLinks/{email} {
      allow get: if verifiedAccount() && email == request.auth.token.email.lower();
      allow list, create, update, delete: if false;
    }

    match /households/{householdId} {
      allow get: if linkedTo(householdId);
      allow list, create, update, delete: if false;

      match /members/{uid} {
        allow read: if linkedTo(householdId);
        allow create: if linkedTo(householdId)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'uid', 'email', 'householdId', 'role', 'displayName',
            'sharePersonalTab', 'hiddenKpis', 'joinedAt', 'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.householdId == householdId
          && request.resource.data.role == accountLink().role
          && request.resource.data.displayName == accountLink().displayName
          && request.resource.data.sharePersonalTab == false
          && request.resource.data.hiddenKpis is list
          && request.resource.data.hiddenKpis.size() == 0;
        allow update: if linkedTo(householdId)
          && uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.role == resource.data.role
          && request.resource.data.sharePersonalTab is bool
          && request.resource.data.hiddenKpis is list
          && request.resource.data.hiddenKpis.size() <= 4
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'sharePersonalTab', 'hiddenKpis', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // Current is the CAS-protected pointer. Legacy inline documents remain readable.
      match /budgetState/current {
        function validStatePointer() {
          let data = request.resource.data;
          let generation = get(/databases/$(database)/documents/households/$(householdId)/budgetState/current/generations/$(data.activeGeneration)).data;
          return data.stateFormat == 'finize-json-chunks-v1'
            && data.schema == 11 && data.app == 'finize'
            && data.baseVersion == data.syncVersion - 1
            && generation.complete == true
            && generation.generation == data.activeGeneration
            && generation.stateFormat == data.stateFormat
            && generation.schema == data.schema
            && generation.chunkCount == data.chunkCount
            && generation.totalByteLength == data.totalByteLength
            && generation.totalSha256 == data.totalSha256
            && generation.stateMeta == data.stateMeta
            && data.revision == data.stateMeta.revision;
        }
        allow read: if linkedTo(householdId);
        allow create: if legacyWriter(householdId)
          && request.resource.data.syncVersion == 1
          && request.resource.data.commitId is string
          && (!('stateFormat' in request.resource.data) || validStatePointer());
        allow update: if legacyWriter(householdId)
          && request.resource.data.syncVersion is int
          && request.resource.data.commitId is string
          && ((!('stateFormat' in request.resource.data) && !('stateFormat' in resource.data)) || validStatePointer())
          && (!('revision' in resource.data) || request.resource.data.revision >= resource.data.revision)
          && (
            (!('syncVersion' in resource.data) && request.resource.data.syncVersion == 1)
            || ('syncVersion' in resource.data
              && request.resource.data.syncVersion == resource.data.syncVersion + 1)
          );
        allow delete: if false;

        match /generations/{generationId} {
          function validDescriptor() {
            let data = request.resource.data;
            return data.generation == generationId
              && data.stateFormat == 'finize-json-chunks-v1'
              && data.schema == 11 && data.stateMeta.schemaVersion == 11
              && data.stateMeta.revision is int
              && data.chunkCount is int && data.chunkCount > 0 && data.chunkCount <= 10000
              && data.totalByteLength is int && data.totalByteLength > 0
              && data.totalByteLength <= data.chunkCount * 240000
              && data.totalSha256 is string && data.totalSha256.size() == 64;
          }
          function completeChain() {
            let last = get(/databases/$(database)/documents/households/$(householdId)/budgetState/current/generations/$(generationId)/chunks/$(string(resource.data.chunkCount - 1))).data;
            return last.generation == generationId
              && last.sequence == resource.data.chunkCount - 1
              && last.chunkCount == resource.data.chunkCount
              && last.cumulativeBytes == resource.data.totalByteLength;
          }
          allow read: if linkedTo(householdId);
          allow create: if legacyWriter(householdId) && validDescriptor() && request.resource.data.complete == false;
          allow update: if legacyWriter(householdId)
            && (request.resource.data == resource.data
              || (resource.data.complete == false && request.resource.data.complete == true
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']) && completeChain()));
          allow delete: if false;

          match /chunks/{chunkId} {
            function validChunk() {
              let data = request.resource.data;
              let generation = get(/databases/$(database)/documents/households/$(householdId)/budgetState/current/generations/$(generationId)).data;
              return generation.complete == false
                && data.generation == generationId && data.chunkCount == generation.chunkCount
                && data.sequence is int && data.sequence >= 0 && data.sequence < generation.chunkCount
                && chunkId == string(data.sequence)
                && data.payload is string && data.payload.size() <= 240000
                && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 240000
                && data.sha256 is string && data.sha256.size() == 64
                && data.cumulativeBytes is int
                && ((data.sequence == 0 && data.cumulativeBytes == data.byteLength)
                  || (data.sequence > 0 && data.cumulativeBytes == data.byteLength
                    + get(/databases/$(database)/documents/households/$(householdId)/budgetState/current/generations/$(generationId)/chunks/$(string(data.sequence - 1))).data.cumulativeBytes));
            }
            allow read: if linkedTo(householdId);
            allow create: if legacyWriter(householdId) && validChunk();
            allow update: if legacyWriter(householdId) && request.resource.data == resource.data;
            allow delete: if false;
          }
        }
      }

      match /imports/{importId} {
        allow read: if linkedTo(householdId);
        allow create: if legacyWriter(householdId)
          && request.resource.data.version is int
          && request.resource.data.version > 0
          && request.resource.data.operationId is string;
        allow update: if legacyWriter(householdId)
          && (!('lifecycle' in resource.data) || resource.data.lifecycle != 'deleted')
          && request.resource.data.version is int
          && request.resource.data.operationId is string
          && (
            (!('version' in resource.data) && request.resource.data.baseVersion == 0)
            || ('version' in resource.data
              && request.resource.data.baseVersion == resource.data.version
              && request.resource.data.version > resource.data.version)
            || (request.resource.data == resource.data)
          );
        // A technical tombstone prevents stale clients from resurrecting a deleted batch.
        allow delete: if false;
        match /chunks/{chunkId} {
          allow read: if linkedTo(householdId);
          allow create: if legacyWriter(householdId)
            && (!exists(/databases/$(database)/documents/households/$(householdId)/imports/$(importId))
              || !('lifecycle' in get(/databases/$(database)/documents/households/$(householdId)/imports/$(importId)).data)
              || get(/databases/$(database)/documents/households/$(householdId)/imports/$(importId)).data.lifecycle != 'deleted');
          allow update: if legacyWriter(householdId) && request.resource.data == resource.data;
          allow delete: if legacyWriter(householdId);
        }
      }

      match /financialStorage/current {
        allow read: if linkedTo(householdId);
        allow create: if linkedTo(householdId)
          && request.resource.data.storageVersion == 2
          && request.resource.data.minClientVersion == 117
          && request.resource.data.epoch is string
          && request.resource.data.phase == 'preparing'
          && request.resource.data.sourceVersion == (exists(/databases/$(database)/documents/households/$(householdId)/budgetState/current)
            ? get(/databases/$(database)/documents/households/$(householdId)/budgetState/current).data.syncVersion : 0);
        allow update: if linkedTo(householdId)
          && request.resource.data.storageVersion == resource.data.storageVersion
          && request.resource.data.minClientVersion == resource.data.minClientVersion
          && request.resource.data.epoch == resource.data.epoch
          && request.resource.data.sourceVersion == resource.data.sourceVersion
          && request.resource.data.sourcePointerHash == resource.data.sourcePointerHash
          && request.resource.data.sourceImportHeadersHash == resource.data.sourceImportHeadersHash
          && request.resource.data.sourceStateHash == resource.data.sourceStateHash
          && request.resource.data.sourceImportsHash == resource.data.sourceImportsHash
          && (request.resource.data == resource.data
            || (resource.data.phase == 'preparing' && request.resource.data.phase == 'verified'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','verifiedStateHash','verifiedRecordCount','verifiedPeriodCount'])
              && get(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(resource.data.epoch)/meta/head).data.stateHash == request.resource.data.verifiedStateHash)
            || (resource.data.phase == 'verified' && request.resource.data.phase == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])));
        allow delete: if false;
      }

      match /financialEpochs/{epoch} {
        function control() {
          return get(/databases/$(database)/documents/households/$(householdId)/financialStorage/current).data;
        }
        function ownEpoch() {
          return linkedTo(householdId) && control().storageVersion == 2 && control().epoch == epoch;
        }
        function head() {
          return get(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/meta/head).data;
        }
        function opAfter(id) {
          return getAfter(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/operations/$(id)).data;
        }
        function preservesPeriodContract(data) {
          return !('integrityMode' in head()) || head().integrityMode != 'manifest'
            || (data.targetHead.integrityMode == 'manifest'
              && data.verificationMode == 'patch'
              && data.targetHead.manifestHashes is map
              && data.targetHead.settingsHash is string);
        }
        match /meta/head {
          allow read: if ownEpoch();
          allow create: if linkedTo(householdId)
            && getAfter(/databases/$(database)/documents/households/$(householdId)/financialStorage/current).data.epoch == epoch
            && request.resource.data.storageVersion == 2 && request.resource.data.epoch == epoch
            && request.resource.data.revision == 0 && request.resource.data.phase == 'ready';
          allow update: if ownEpoch()
            && request.resource.data.storageVersion == 2 && request.resource.data.epoch == epoch
            && ((resource.data.phase == 'ready' && request.resource.data.phase == 'applying'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','pendingOperation'])
                && opAfter(request.resource.data.pendingOperation).phase == 'applying'
                && opAfter(request.resource.data.pendingOperation).baseRevision == resource.data.revision)
              || (resource.data.phase == 'applying' && request.resource.data.phase == 'ready'
                && request.resource.data.revision == resource.data.revision + 1
                && opAfter(resource.data.pendingOperation).phase == 'committed'
                && request.resource.data == opAfter(resource.data.pendingOperation).targetHead));
          allow delete: if false;
        }
        match /operations/{operationId} {
          allow read: if ownEpoch();
          allow create: if ownEpoch()
            && request.resource.data.storageVersion == 2 && request.resource.data.epoch == epoch
            && request.resource.data.id == operationId && request.resource.data.phase == 'prepared'
            && preservesPeriodContract(request.resource.data)
            && request.resource.data.baseRevision == head().revision && head().phase == 'ready'
            && request.resource.data.targetHead.revision == head().revision + 1
            && request.resource.data.memberCount is int && request.resource.data.memberCount >= 0
            && request.resource.data.memberHash is string;
          allow update: if ownEpoch()
            && (request.resource.data == resource.data
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
                && ((resource.data.phase == 'prepared' && request.resource.data.phase == 'applying'
                    && getAfter(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/meta/head).data.pendingOperation == operationId)
                  || (resource.data.phase == 'applying' && request.resource.data.phase == 'committed'
                    && getAfter(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/meta/head).data == resource.data.targetHead))));
          allow delete: if false;
          match /changes/{changeId} {
            allow read: if ownEpoch();
            allow create: if ownEpoch()
              && get(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/operations/$(operationId)).data.phase == 'prepared'
              && request.resource.data.id == changeId;
            allow update: if ownEpoch() && request.resource.data == resource.data;
            allow delete: if false;
          }
          match /members/{id} {
            allow read: if ownEpoch();
            allow create: if ownEpoch()
              && get(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/operations/$(operationId)).data.phase == 'prepared'
              && request.resource.data.id == id && request.resource.data.sha256 is string
              && request.resource.data.storageRevision is int;
            allow update: if ownEpoch() && request.resource.data == resource.data;
            allow delete: if false;
          }
        }
        function applyingChange(kind,id) {
          let current = head();
          let operation = get(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/operations/$(current.pendingOperation)).data;
          let change = get(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/operations/$(current.pendingOperation)/changes/$(kind + '_' + id)).data;
          return current.phase == 'applying' && operation.phase == 'applying'
            && change.path == kind + '/' + id && request.resource.data == change.after;
        }
        match /records/{recordId} {
          allow read: if ownEpoch();
          allow create: if ownEpoch() && applyingChange('records',recordId);
          allow update: if ownEpoch() && applyingChange('records',recordId)
            && request.resource.data.sourceHash == resource.data.sourceHash;
          allow delete: if false;
        }
        match /periods/{month} {
          allow read: if ownEpoch();
          allow create, update: if ownEpoch() && applyingChange('periods',month);
          allow delete: if false;
        }
        match /manifests/{id} {
          allow read: if ownEpoch();
          allow create, update: if ownEpoch() && applyingChange('manifests',id);
          allow delete: if false;
        }
        match /globals/{id} {
          allow read: if ownEpoch();
          allow create, update: if ownEpoch() && applyingChange('globals',id);
          allow delete: if false;
        }
        match /receipts/{id} {
          allow read: if ownEpoch();
          allow create: if ownEpoch() && request.resource.data.id == id
            && request.resource.data.storageVersion == 2 && request.resource.data.epoch == epoch
            && request.resource.data.outcome == 'prepared'
            && opAfter(request.resource.data.cloudOperation).phase == 'applying'
            && get(/databases/$(database)/documents/households/$(householdId)/financialEpochs/$(epoch)/operations/$(request.resource.data.cloudOperation)/members/$(id)).data == {
              'id': id, 'sha256': request.resource.data.sha256,
              'storageRevision': request.resource.data.storageRevision
            }
            && request.resource.data.cloudRevision == opAfter(request.resource.data.cloudOperation).targetHead.revision;
          allow update: if ownEpoch() && request.resource.data == resource.data;
          allow delete: if false;
        }
      }
    }

    // Het oude openbare pad blijft alleen als herstelbron bestaan.
    // Release 79 leest en schrijft uitsluitend via het beveiligde huishouden.
    match /budgetPlanners/finize {
      allow read, create, update, delete: if false;

      match /imports/{importId} {
        allow read, write: if false;

        match /chunks/{chunkId} {
          allow read, write: if false;
        }
      }
    }

    // Alle overige Firestore-documenten blijven standaard gesloten.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
