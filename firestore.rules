rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Finize gebruikt momenteel een gedeelde, niet-geauthenticeerde planner.
    // Rootwrites moeten via het transactionele syncprotocol lopen.
    match /budgetPlanners/finize {
      allow read: if true;
      allow create: if request.resource.data.syncVersion == 1
        && request.resource.data.commitId is string;
      allow update: if request.resource.data.syncVersion is int
        && request.resource.data.commitId is string
        && (
          (!("syncVersion" in resource.data) && request.resource.data.syncVersion == 1)
          || ("syncVersion" in resource.data
            && request.resource.data.syncVersion == resource.data.syncVersion + 1)
        );

      match /imports/{importId} {
        allow read, write: if true;

        match /chunks/{chunkId} {
          allow read, write: if true;
        }
      }
    }

    // Alle overige Firestore-documenten blijven standaard gesloten.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
